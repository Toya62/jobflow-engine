# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# GitHub Personal Access Token (for pipeline automation, commits, PRs)
GITHUB_TOKEN=your_github_token_here

# LLM Providers (for job profile matching, CV tailoring, and cover letters)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup keys for rotation
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key
GROQ_API_KEY=your_groq_api_key_here

# LinkedIn Scraping Cookie (Optional - for authenticated scraping)
LINKEDIN_LI_AT=your_linkedin_li_at_cookie

# Telegram Bot Notification (Optional)
# 1. Talk to @BotFather on Telegram to create bot and obtain TELEGRAM_BOT_TOKEN
# 2. Start a chat with your bot, then get your chat ID (e.g., via @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
